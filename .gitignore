#################################################
# COMPOSER (if PHP used)
#################################################
# Anchored to repo root — a bare "vendor/" would also match, and silently
# exclude, assets/vendor/ (bundled frontend libs like bootstrap-icons that
# must ship with the plugin).
/vendor/
composer.lock

#################################################
# NEXT / REACT / MODERN BUILD TOOLS
#################################################
.next/
.nuxt/
.svelte-kit/
.storybook-out/
storybook-static/

