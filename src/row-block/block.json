{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "adaire/row-block",
  "title": "Row (Free)",
  "description": "A row container with configurable column layouts.",
  "category": "adaire-layout-sections",
  "icon": "layout",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "customClassName": true,
    "spacing": { "padding": true, "margin": true },
    "color": { "background": true, "gradients": true }
  },
  "attributes": {
    "layout": {
      "type": "string",
      "default": ""
    },
    "columnWidths": {
      "type": "array",
      "default": []
    },
    "align": {
      "type": "string",
      "default": ""
    },
    "gap": {
      "type": "number",
      "default": 16
    },
    "verticalAlign": {
      "type": "string",
      "default": ""
    },
    "mobileColumns": {
      "type": "string",
      "default": ""
    },
    "borderEnabled": {
      "type": "boolean",
      "default": false
    },
    "borderWidth": {
      "type": "number",
      "default": 1
    },
    "borderStyle": {
      "type": "string",
      "default": "solid"
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderRadius": {
      "type": "number",
      "default": 0
    }
  }
}
