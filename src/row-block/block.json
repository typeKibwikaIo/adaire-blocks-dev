{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "adaire/row-block",
  "title": "Row (Free)",
  "description": "A row container with configurable column layouts.",
  "category": "adaire-layout-sections",
  "icon": "layout",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "customClassName": true,
    "spacing": { "padding": true, "margin": true },
    "color": { "background": true, "gradients": true }
  },
  "attributes": {
    "layout": {
      "type": "string",
      "default": "",
      "enum": [
        "",
        "manual",
        "1-col",
        "2-col-50-50",
        "2-col-66-33",
        "2-col-33-66",
        "3-col-33-33-33",
        "3-col-25-50-25",
        "4-col-25-25-25-25"
      ]
    },
    "columnWidths": {
      "type": "array",
      "default": []
    },
    "align": {
      "type": "string",
      "default": "",
      "enum": [ "", "wide", "full" ]
    },
    "gap": {
      "type": "number",
      "default": 16
    },
    "verticalAlign": {
      "type": "string",
      "default": "",
      "enum": [ "", "top", "center", "bottom" ]
    },
    "mobileColumns": {
      "type": "string",
      "default": "",
      "enum": [ "", "1", "2" ]
    },
    "borderEnabled": {
      "type": "boolean",
      "default": false
    },
    "borderWidth": {
      "type": "number",
      "default": 1
    },
    "borderStyle": {
      "type": "string",
      "default": "solid",
      "enum": [ "solid", "dashed", "dotted", "double", "groove" ]
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderRadius": {
      "type": "number",
      "default": 0
    }
  }
}
