{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "create-block/pdf-reader-block",
    "version": "0.1.0",
    "title": "PDF Reader",
    "category": "adaire-media",
    "description": "Upload a PDF and display it as an embedded, readable viewer with download and open-in-new-tab actions.",
    "supports": {
        "html": false,
        "anchor": true
    },
    "textdomain": "adaire-blocks",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "attributes": {
        "eyebrow": {
            "type": "string",
            "default": "PDF"
        },
        "heading": {
            "type": "string",
            "default": "Read the PDF"
        },
        "text": {
            "type": "string",
            "default": "Share a PDF resource, brochure, guide, or document."
        },
        "buttonText": {
            "type": "string",
            "default": "Download PDF"
        },
        "buttonUrl": {
            "type": "string",
            "default": "#"
        },
        "accentColor": {
            "type": "string",
            "default": "#d52940"
        },
        "backgroundColor": {
            "type": "string",
            "default": "#111827"
        },
        "textColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "pdfUrl": {
            "type": "string",
            "default": ""
        },
        "fileName": {
            "type": "string",
            "default": ""
        },
        "fileSize": {
            "type": "string",
            "default": ""
        },
        "pageCount": {
            "type": "string",
            "default": ""
        },
        "passwordHint": {
            "type": "string",
            "default": ""
        },
        "fallbackMessage": {
            "type": "string",
            "default": "No PDF has been uploaded yet."
        },
        "viewerHeight": {
            "type": "number",
            "default": 640
        },
        "borderRadius": {
            "type": "number",
            "default": 18
        },
        "shadow": {
            "type": "boolean",
            "default": true
        },
        "showDownload": {
            "type": "boolean",
            "default": true
        },
        "showOpen": {
            "type": "boolean",
            "default": true
        },
        "showIcon": {
            "type": "boolean",
            "default": true
        },
        "buttonColor": {
            "type": "string",
            "default": "#d52940"
        },
        "frameBorderColor": {
            "type": "string",
            "default": "#e5e7eb"
        },
        "buttonWidth": {
            "type": "string",
            "default": "auto"
        },
        "buttonHeight": {
            "type": "string",
            "default": "auto"
        },
        "buttonHoverColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "buttonHoverBackgroundColor": {
            "type": "string",
            "default": "#111827"
        },
        "buttonHoverBorderColor": {
            "type": "string",
            "default": "#111827"
        },
        "buttonHoverEffect": {
            "type": "string",
            "default": "lift",
            "enum": [
                "lift",
                "glow",
                "darken",
                "none"
            ]
        },
        "backgroundType": {
            "type": "string",
            "default": "solid",
            "enum": [
                "solid",
                "gradient",
                "image"
            ]
        },
        "backgroundImage": {
            "type": "string",
            "default": ""
        },
        "backgroundGradient": {
            "type": "string",
            "default": "linear-gradient(135deg,#111827,#3b0764)"
        }
    },
    "icon": "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect width=\"24\" height=\"24\" rx=\"5\" fill=\"#F0F0F1\"/>\n<path d=\"M7 3.5C7 2.94772 7.44772 2.5 8 2.5H14L18 6.5V20.5C18 21.0523 17.5523 21.5 17 21.5H8C7.44772 21.5 7 21.0523 7 20.5V3.5Z\" fill=\"white\" stroke=\"#111827\" stroke-width=\"1.2\"/>\n<path d=\"M14 2.5V6C14 6.27614 14.2239 6.5 14.5 6.5H18\" stroke=\"#111827\" stroke-width=\"1.2\" stroke-linejoin=\"round\"/>\n<rect x=\"9\" y=\"10.6\" width=\"6.5\" height=\"4.2\" rx=\"0.9\" fill=\"#D52940\"/>\n<path d=\"M10 11.9H14.5M10 12.9H13.2\" stroke=\"white\" stroke-width=\"0.6\" stroke-linecap=\"round\"/>\n<path d=\"M9 16.9H15.5\" stroke=\"#111827\" stroke-width=\"1\" stroke-linecap=\"round\"/>\n<path d=\"M9 18.4H12.8\" stroke=\"#111827\" stroke-width=\"1\" stroke-linecap=\"round\"/>\n</svg>"
}