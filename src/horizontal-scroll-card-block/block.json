{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "create-block/horizontal-scroll-card-block",
    "version": "0.1.0",
    "title": "Horizontal Scroll Card",
    "category": "adaire-effects-interactions",
    "parent": [ "create-block/horizontal-scroll-carousel-block" ],
    "icon": "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"24\" height=\"24\" rx=\"5\" fill=\"#7C3AED\"/><rect x=\"4\" y=\"5\" width=\"16\" height=\"14\" rx=\"2\" fill=\"white\" opacity=\"0.15\"/><rect x=\"4\" y=\"5\" width=\"16\" height=\"14\" rx=\"2\" stroke=\"white\" stroke-width=\"1.5\"/><rect x=\"7\" y=\"8\" width=\"5\" height=\"2\" rx=\"1\" fill=\"white\"/><rect x=\"7\" y=\"12\" width=\"8\" height=\"1.5\" rx=\"0.75\" fill=\"white\" opacity=\"0.7\"/><rect x=\"7\" y=\"15\" width=\"4\" height=\"1.5\" rx=\"0.75\" fill=\"white\" opacity=\"0.5\"/></svg>",
    "description": "A single card for the Horizontal Scroll Carousel block.",
    "supports": {
        "html": false,
        "reusable": false,
        "inserter": false,
        "anchor": true
    },
    "attributes": {
        "cardTitle": {
            "type": "string",
            "default": "Your Card Title"
        },
        "cardText": {
            "type": "string",
            "default": "Add your card description here."
        },
        "imageId": {
            "type": "number",
            "default": 0
        },
        "imageUrl": {
            "type": "string",
            "default": ""
        },
        "imageAlt": {
            "type": "string",
            "default": ""
        },
        "backgroundColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "borderRadius": {
            "type": "number",
            "default": 16
        },
        "shadowBlur": {
            "type": "number",
            "default": 20
        },
        "shadowSpread": {
            "type": "number",
            "default": 0
        },
        "shadowColor": {
            "type": "string",
            "default": "#000000"
        },
        "shadowOpacity": {
            "type": "number",
            "default": 0.1
        },
        "shadowType": {
            "type": "string",
            "default": ""
        },
        "borderEnabled": {
            "type": "boolean",
            "default": false
        },
        "borderColor": {
            "type": "string",
            "default": "#e0e0e0"
        },
        "borderWidth": {
            "type": "number",
            "default": 1
        },
        "borderStyle": {
            "type": "string",
            "default": "solid"
        },
        "titleColor": {
            "type": "string",
            "default": "#111111"
        },
        "textColor": {
            "type": "string",
            "default": "#555555"
        },
        "titleFontSize": {
            "type": "string",
            "default": "1.75rem"
        },
        "titleFontWeight": {
            "type": "string",
            "default": "700"
        },
        "textFontSize": {
            "type": "string",
            "default": "0.9375rem"
        },
        "textFontWeight": {
            "type": "string",
            "default": "400"
        },
        "cardLeftJustify": {
            "type": "string",
            "default": "space-between"
        },
        "cardLeftGap": {
            "type": "string",
            "default": "16px"
        },
        "cardInnerJustify": {
            "type": "string",
            "default": "space-between"
        },
        "cardInnerGap": {
            "type": "string",
            "default": "32px"
        },
        "responsiveImageWidth": {
            "type": "object",
            "default": {
                "mobile":      "100%",
                "tablet":      "45%",
                "smallLaptop": "45%",
                "desktop":     "45%",
                "bigDesktop":  "45%"
            }
        },
        "responsiveCardPadding": {
            "type": "object",
            "default": {
                "mobile":      { "top": "32px", "right": "24px", "bottom": "32px", "left": "24px" },
                "tablet":      { "top": "40px", "right": "32px", "bottom": "40px", "left": "32px" },
                "smallLaptop": { "top": "48px", "right": "40px", "bottom": "48px", "left": "40px" },
                "desktop":     { "top": "48px", "right": "48px", "bottom": "48px", "left": "48px" },
                "bigDesktop":  { "top": "60px", "right": "60px", "bottom": "60px", "left": "60px" }
            }
        }
    },
    "textdomain": "adaire-blocks-dev2",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
